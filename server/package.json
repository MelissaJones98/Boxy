{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Boxy REST API (Express + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "migrate": "node-pg-migrate -m migrations",
    "migrate:test": "node-pg-migrate -m migrations -d TEST_DATABASE_URL",
    "migrate:create": "node-pg-migrate create -m migrations -j sql"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup/loadEnv.js"
    ],
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
