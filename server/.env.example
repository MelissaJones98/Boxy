# server/.env.example — a template for server/.env (which is git-ignored).
# Copy this file to server/.env and fill in your real values. Never commit .env.
#
# Connection string format:
#   postgres://<user>:<password>@<host>:<port>/<database>
# If your password has special characters (@ : / # ? etc.), URL-encode them,
# e.g. "p@ss" becomes "p%40ss".

# Port the API listens on locally (the React dev server uses 5173).
PORT=3001

# Development database: used by `npm run dev` and `npm start`.
DATABASE_URL=postgres://boxy:your-boxy-password@localhost:5432/boxy

# Test database: used automatically whenever Jest runs (Jest sets NODE_ENV=test).
# Tests wipe this database, so it must NEVER point at the development database.
TEST_DATABASE_URL=postgres://boxy:your-boxy-password@localhost:5432/boxy_test

# Signs the login session cookie so it can't be forged. Use a long random
# value, different on every machine and in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out (their existing cookies stop being valid).
SESSION_SECRET=replace-with-a-long-random-string
